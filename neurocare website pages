<!-- chat.html -->
{% extends "base.html" %}
{% block content %}
<h2>Chat with SmartCare Bot</h2>
<form method="POST">
    <div class="mb-3">
        <label for="user_input" class="form-label">Ask your question:</label>
        <input type="text" class="form-control" name="user_input" required>
    </div>
    <button type="submit" class="btn btn-success">Send</button>
</form>

{% if user_input %}
    <div class="mt-4">
        <p><strong>You:</strong> {{ user_input }}</p>
        <p><strong>Bot:</strong> {{ bot_response }}</p>
    </div>
{% endif %}
{% endblock %} 

